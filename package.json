{
  "name": "ai-usage-monitor",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.2.0 <27"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "react-router build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "tsx --test node-tests/*.test.ts",
    "collect": "tsx server/cli.ts collect",
    "status": "tsx server/cli.ts status",
    "history": "tsx server/cli.ts history",
    "dump": "tsx server/cli.ts dump",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "dependencies": {
    "@react-router/express": "8.4.0",
    "@react-router/node": "8.4.0",
    "express": "5.2.1",
    "isbot": "5.2.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@react-router/dev": "8.4.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
